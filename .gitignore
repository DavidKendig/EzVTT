# --- EzVTT runtime data -------------------------------------------------------
# Everything the running application creates. Back this up by copying data/;
# never commit it. Contains uploaded maps, the SQLite database (with password
# hashes and session tokens), and the PID file.
data/

# --- Map assets ---------------------------------------------------------------
# The Tom Cartos Open License Asset Bundle is ~537 MB across 800 files and is
# installed by scripts/fetch-assets rather than tracked here. The licence notice
# is committed; the artwork is not.
assets/bundled/*
!assets/bundled/LICENSE-ASSETS.md
!assets/bundled/.gitkeep

# The source bundle as delivered, if it is unpacked inside the repo.
Tom Cartos Open License Asset Bundle/

# --- Generated at packaging time ----------------------------------------------
# Produced by scripts/gen_third_party_licenses.py for bundled builds only.
THIRD_PARTY_LICENSES.md

# --- Python -------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.spec
!ezvtt.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Editors and OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Local overrides ----------------------------------------------------------
.env
.env.local
ezvtt.local.toml

# --- Logs ---------------------------------------------------------------------
*.log
logs/
